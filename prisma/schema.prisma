generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  messages  Message[]
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  pools       Pool[] @relation("CreatedPools") // App pools created by the user
  joinedPools Pool[] @relation("JoinedPools")  // Pools the user has joined as a rider

  accounts Account[]
  sessions Session[]
}

model Pool {
  messages  Message[]
  id           String   @id @default(cuid())
  creatorId    String
  creator      User     @relation("CreatedPools", fields: [creatorId], references: [id])
  participants User[]   @relation("JoinedPools") // Users who joined this pool
  routeFrom    String   
  routeTo      String   
  spotsTotal   Int      
  spotsLeft    Int
  leavingAt    DateTime
  status       String   @default("ACTIVE") 
  createdAt    DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
model Message {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())
  
  poolId    String
  pool      Pool     @relation(fields: [poolId], references: [id], onDelete: Cascade)
  
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
}